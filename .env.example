ORIGIN_ENV=dev
ORIGIN_HOST=127.0.0.1
ORIGIN_PORT=8000
ORIGIN_LOG_LEVEL=INFO
ORIGIN_LOCALE=pt-BR
# White label: names, logo, colors, persona and texts (copy brand/brand.example.json)
ORIGIN_BRAND_PATH=./brand/brand.json

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TEMPERATURE=0.7
# false disables "thinking" on reasoning models (qwen3); leave empty for model default
OLLAMA_REASONING=false
# Context window (tokens), or "auto": the model's limit, capped by what fits in VRAM
# next to the embedding model (NVIDIA GPUs; on an 8 GB RTX 4070 with qwen3:8b + bge-m3
# that is 6144 - at 7168 and 8192 Ollama swapped the two models on every call)
OLLAMA_NUM_CTX=auto
# "auto" without an NVIDIA GPU (or with Ollama down at startup)
OLLAMA_NUM_CTX_FALLBACK=4096
# VRAM kept free beyond both model files and the KV cache; raise it if models swap
OLLAMA_VRAM_OVERHEAD_GB=1.15
# Seconds models stay loaded after the last request (-1 = forever)
OLLAMA_KEEP_ALIVE=1800
# Preload models on startup so the first request is fast
OLLAMA_WARMUP=true
# Retries for transient Ollama failures (total tries; the wait doubles from the backoff)
OLLAMA_RETRY_ATTEMPTS=3
OLLAMA_RETRY_BACKOFF=0.5

VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/.chroma
MEMORY_COLLECTION=origin
MEMORY_TOP_K=4
MEMORY_MIN_SCORE=0.45
# Also search memory with the previous exchange, so follow-ups ("and hers?") find facts
MEMORY_CONTEXTUAL_RECALL=true
# Calibrated on bge-m3 (recalibrate if you change OLLAMA_EMBED_MODEL):
# >= dedup -> same fact, not stored again; >= conflict -> a yes/no model check decides
# whether the new fact replaces the old one
MEMORY_DEDUP_THRESHOLD=0.92
MEMORY_CONFLICT_THRESHOLD=0.55

SQLITE_PATH=./data/origin.db
# Which embedding model indexed the memories + thresholds calibrated for it
CALIBRATION_PATH=./data/calibration.json
# JSON backups of all memories, written before each reindex
MEMORY_BACKUP_DIR=./data/backups

# Context optimization. Fractions are of the usable budget (window - reply reserve).
# CONTEXT_WINDOW defaults to OLLAMA_NUM_CTX; the reserve stays free for the answer.
CONTEXT_REPLY_RESERVE=1024
# The meter turns yellow past WARN_AT. Past COMPACT_AT, old messages are folded into a
# running summary until usage is back under COMPACT_TARGET (the transcript is kept).
CONTEXT_WARN_AT=0.6
CONTEXT_COMPACT_AT=0.75
CONTEXT_COMPACT_TARGET=0.5
# Messages kept verbatim when folding (never fewer than MIN_RECENT)
CONTEXT_KEEP_RECENT=6
CONTEXT_MIN_RECENT=2
# Soft summary budget, capped at 20% of the usable window
CONTEXT_SUMMARY_MAX_TOKENS=800

TOOLS_ENABLED=true
# JSON list of tool names to skip, e.g. ["remember"]
TOOLS_DISABLED=[]
AGENT_MAX_TOOL_ITERATIONS=5
# Extra "decide tools first" turn; fixes compound questions on small models (~+0.4s)
AGENT_TOOL_ROUTING=true
# Choosing tools is classification; sampling noise there only causes skipped tools
AGENT_ROUTING_TEMPERATURE=0
